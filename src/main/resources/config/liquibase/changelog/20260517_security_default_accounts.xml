<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260517-01-disable-sample-user" author="security">
        <update tableName="jhi_user">
            <column name="activated" valueBoolean="false"/>
            <where>login = 'user'</where>
        </update>
    </changeSet>

    <changeSet id="20260517-02-update-admin-email" author="security">
        <update tableName="jhi_user">
            <column name="email" value="med-portal-admin@behsa.com"/>
            <where>login = 'admin' AND email = 'admin@localhost'</where>
        </update>
    </changeSet>

</databaseChangeLog>

    <changeSet id="20260915-08-bpmn-seed-groups" author="upgrade">
        <insert tableName="TBL_BPMN_ELEMENT_GROUP"><column name="group_key" valueSequenceNext="BPMN_ELEMENT_GROUPS_SEQ"/><column name="group_code" value="CORE_BPMN"/><column name="group_name" value="Core BPMN Elements"/><column name="enabled" valueNumeric="1"/></insert>
        <insert tableName="TBL_BPMN_ELEMENT_GROUP"><column name="group_key" valueSequenceNext="BPMN_ELEMENT_GROUPS_SEQ"/><column name="group_code" value="FILE_PROCESSING"/><column name="group_name" value="File Processing Elements"/><column name="enabled" valueNumeric="1"/></insert>

        <sql>
            INSERT INTO TBL_BPMN_GROUP_ELEMENT (group_key, element_key)
            SELECT g.group_key, e.element_key
              FROM TBL_BPMN_ELEMENT_GROUP g
              CROSS JOIN TBL_BPMN_ELEMENT e
             WHERE g.group_code = 'CORE_BPMN'
               AND e.element_code IN ('BPMN_START_EVENT', 'BPMN_END_EVENT')
        </sql>
        <sql>
            INSERT INTO TBL_BPMN_GROUP_ELEMENT (group_key, element_key)
            SELECT g.group_key, e.element_key
              FROM TBL_BPMN_ELEMENT_GROUP g
              CROSS JOIN TBL_BPMN_ELEMENT e
             WHERE g.group_code = 'FILE_PROCESSING'
               AND e.element_code IN ('FILE_RECEIVER', 'FILE_TRANSMITTER', 'MERGER', 'FRAGMENTER', 'CDR_PARSER', 'CSV_TRANSFORMER')
        </sql>

        <!-- Initial MCI assignment requested for the current portal.  No default/fallback is
             assigned to future products: administrators explicitly map their groups in DB. -->
        <sql>
            INSERT INTO TBL_PRODUCT_BPMN_GROUP (product_key, group_key)
            SELECT p.product_key, g.group_key
              FROM TBL_PRODUCTS p
              CROSS JOIN TBL_BPMN_ELEMENT_GROUP g
             WHERE UPPER(p.product_name) = 'MCI'
               AND g.group_code = 'FILE_PROCESSING'
        </sql>
    </changeSet>
</databaseChangeLog>

entity Module{
    moduleName String required maxlength(50),
    defaultPort String required maxlength(4) minlength(4),
    redisKeyPrefix String required maxlength(5) minlength(5),
    status Long required min(0) max(1),
    loggingMode String required,
    loggingFilter String maxlength(500),
    dnsName String maxlength(100) required
}

entity Config{
    property String required maxlength(100),
    pValue String required maxlength(300),
    commentDesc String maxlength(200)
}

/*entity Instance{
    moduleName String required maxlength(50),
    ip String required maxlength(50),
    port String required maxlength(10),
    moduleStatus String required maxlength(50),
    lastUpdateDate LocalDate required,
    threadPoolQueueSize Long,
    moduleStartTime Long,
    totalProcessedWork Long,
    totalProcessedTask Long,
    processedStatistics String
}*/

entity Instance{
    moduleName String required maxlength(50),
    port String required maxlength(10),
    moduleStatus String required maxlength(50),
    lastUpdateDate LocalDate required,
    threadPoolQueueSize Long,
    moduleStartTime Long,
    totalProcessedWork Long,
    totalProcessedTask Long,
    processedStatistics String,
    hostName String required maxlength(50)
}

entity Version{
    tableName String required maxlength(100),
    moduleName String required maxlength(50),
    tableVersion Long required
}

entity Product{
    productName String required maxlength(3),
    productDesc String required maxlength(300)
}

entity Flow{
    flowName String required maxlength(6),
    flowDesc String required maxlength(300),
    flow String requiredf
}

relationship OneToMany{
    Module{configs} to Config{module required},
    Product{flows} to Flow{product required}
}


// Set pagination options
paginate all with infinite-scroll
paginate all with pagination

// Use Data Transfert Objects (DTO)
// dto * with mapstruct
dto * with mapstruct

// Set service options to all except few
service * with serviceImpl

// Set an angular suffix
// angularSuffix * with mySuffix
filter all

<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      BPMN element visibility / authorization model.

      Product -> Element Group -> BPMN Element

      Product and group membership are intentionally many-to-many.  The same reusable group may be
      assigned to several products and an element may be present in several groups.  The Angular
      editor uses bpmn_type to filter creation UI; the Java API validates saved/imported XML using
      namespace_uri + local_name so XML prefix renaming cannot bypass the rule.
    -->

    <changeSet id="20260915-01-bpmn-element-group-seq" author="upgrade">
        <preConditions onFail="MARK_RAN"><not><sequenceExists sequenceName="BPMN_ELEMENT_GROUPS_SEQ"/></not></preConditions>
        <createSequence sequenceName="BPMN_ELEMENT_GROUPS_SEQ" startValue="1000" incrementBy="1"/>
    </changeSet>

    <changeSet id="20260915-02-bpmn-element-seq" author="upgrade">
        <preConditions onFail="MARK_RAN"><not><sequenceExists sequenceName="BPMN_ELEMENTS_SEQ"/></not></preConditions>
        <createSequence sequenceName="BPMN_ELEMENTS_SEQ" startValue="1000" incrementBy="1"/>
    </changeSet>

    <changeSet id="20260915-03-bpmn-element-group" author="upgrade">
        <preConditions onFail="MARK_RAN"><not><tableExists tableName="TBL_BPMN_ELEMENT_GROUP"/></not></preConditions>
        <createTable tableName="TBL_BPMN_ELEMENT_GROUP">
            <column name="group_key" type="bigint"><constraints primaryKey="true" nullable="false"/></column>
            <column name="group_code" type="varchar(100)"><constraints nullable="false" unique="true" uniqueConstraintName="uk_bpmn_group_code"/></column>
            <column name="group_name" type="varchar(200)"><constraints nullable="false"/></column>
            <column name="enabled" type="integer" defaultValueNumeric="1"><constraints nullable="false"/></column>
        </createTable>
    </changeSet>

    <changeSet id="20260915-04-bpmn-element" author="upgrade">
        <preConditions onFail="MARK_RAN"><not><tableExists tableName="TBL_BPMN_ELEMENT"/></not></preConditions>
        <createTable tableName="TBL_BPMN_ELEMENT">
            <column name="element_key" type="bigint"><constraints primaryKey="true" nullable="false"/></column>
            <column name="element_code" type="varchar(100)"><constraints nullable="false" unique="true" uniqueConstraintName="uk_bpmn_element_code"/></column>
            <column name="bpmn_type" type="varchar(150)"><constraints nullable="false" unique="true" uniqueConstraintName="uk_bpmn_element_type"/></column>
            <column name="namespace_uri" type="varchar(300)"><constraints nullable="false"/></column>
            <column name="local_name" type="varchar(150)"><constraints nullable="false"/></column>
            <column name="palette_action" type="varchar(150)"/>
            <column name="display_name" type="varchar(200)"><constraints nullable="false"/></column>
            <column name="enabled" type="integer" defaultValueNumeric="1"><constraints nullable="false"/></column>
            <column name="sort_order" type="integer" defaultValueNumeric="0"><constraints nullable="false"/></column>
        </createTable>
        <addUniqueConstraint tableName="TBL_BPMN_ELEMENT" columnNames="namespace_uri,local_name" constraintName="uk_bpmn_element_xml_name"/>
    </changeSet>

    <changeSet id="20260915-05-bpmn-group-element" author="upgrade">
        <preConditions onFail="MARK_RAN"><not><tableExists tableName="TBL_BPMN_GROUP_ELEMENT"/></not></preConditions>
        <createTable tableName="TBL_BPMN_GROUP_ELEMENT">
            <column name="group_key" type="bigint"><constraints nullable="false"/></column>
            <column name="element_key" type="bigint"><constraints nullable="false"/></column>
        </createTable>
        <addPrimaryKey tableName="TBL_BPMN_GROUP_ELEMENT" columnNames="group_key,element_key" constraintName="pk_bpmn_group_element"/>
        <addForeignKeyConstraint baseTableName="TBL_BPMN_GROUP_ELEMENT" baseColumnNames="group_key"
                                 referencedTableName="TBL_BPMN_ELEMENT_GROUP" referencedColumnNames="group_key"
                                 constraintName="fk_bpmn_ge_group"/>
        <addForeignKeyConstraint baseTableName="TBL_BPMN_GROUP_ELEMENT" baseColumnNames="element_key"
                                 referencedTableName="TBL_BPMN_ELEMENT" referencedColumnNames="element_key"
                                 constraintName="fk_bpmn_ge_element"/>
        <createIndex tableName="TBL_BPMN_GROUP_ELEMENT" indexName="idx_bpmn_ge_element"><column name="element_key"/></createIndex>
    </changeSet>

    <changeSet id="20260915-06-product-bpmn-group" author="upgrade">
        <preConditions onFail="MARK_RAN"><not><tableExists tableName="TBL_PRODUCT_BPMN_GROUP"/></not></preConditions>
        <createTable tableName="TBL_PRODUCT_BPMN_GROUP">
            <column name="product_key" type="bigint"><constraints nullable="false"/></column>
            <column name="group_key" type="bigint"><constraints nullable="false"/></column>
        </createTable>
        <addPrimaryKey tableName="TBL_PRODUCT_BPMN_GROUP" columnNames="product_key,group_key" constraintName="pk_product_bpmn_group"/>
        <addForeignKeyConstraint baseTableName="TBL_PRODUCT_BPMN_GROUP" baseColumnNames="product_key"
                                 referencedTableName="TBL_PRODUCTS" referencedColumnNames="product_key"
                                 constraintName="fk_product_bpmn_group_product"/>
        <addForeignKeyConstraint baseTableName="TBL_PRODUCT_BPMN_GROUP" baseColumnNames="group_key"
                                 referencedTableName="TBL_BPMN_ELEMENT_GROUP" referencedColumnNames="group_key"
                                 constraintName="fk_product_bpmn_group_group"/>
        <createIndex tableName="TBL_PRODUCT_BPMN_GROUP" indexName="idx_product_bpmn_group_group"><column name="group_key"/></createIndex>
    </changeSet>


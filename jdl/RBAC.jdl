entity MedAuthority{
    name String required maxlength(50),
    displayName String maxlength(500),
    parentId Long
}

entity Resource{
    name String required maxlength(200),
    displayName String required maxlength(300),
    apiUri String required maxlength(1000),
    resourceType String required maxlength(255)
}

entity ResourceAuthority{
    verb String required maxlength(255)
}

relationship OneToMany{
    MedAuthority{resourceAuthorities} to ResourceAuthority{medAuthority required}
    Resource{resourceAuthorities} to ResourceAuthority{resource required}
}

// Set pagination options
paginate all with infinite-scroll
paginate all with pagination

// Use Data Transfert Objects (DTO)
// dto * with mapstruct
dto * with mapstruct

// Set service options to all except few
service * with serviceImpl

// Set an angular suffix
// angularSuffix * with mySuffix
filter all
